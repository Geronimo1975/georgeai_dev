{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./deploy.sh)",
      "Bash(./deploy.sh --no-content)",
      "Bash(./deploy.sh exports/*)",
      "Bash(./cron/check_payments.sh)",
      "Bash(python3 tests/*)",
      "Bash(pytest tests/*)",
      "Bash(python3 seo/*)",
      "Bash(python3 images/*)",
      "Bash(python3 brand/*)",
      "Bash(ssh macbook-air:*)",
      "Bash(rsync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(diff:*)",
      "Bash(curl -sI https://georgeai.dev/*)",
      "Bash(curl -s https://georgeai.dev/*)",
      "Bash(ffprobe:*)",
      "Bash(unzip -l:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(docker:*)",
      "Bash(ffmpeg:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./deploy/backend.env)",
      "Bash(rm -rf:*)"
    ]
  }
}
