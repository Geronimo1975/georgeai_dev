    {
      "id": "c",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "\nconst SELF = $workflow.id;\nconst wfs = ($('Workflows').first().json.data || []).filter(w=>w.id!==SELF);\nconst ex  = ($('Executions').first().json.data || []).filter(e=>e.workflowId!==SELF);\nconst now = Date.now(), day = 864e5;\nconst days = Array.from({length:7},(_,i)=>{const d=new Date(now-(6-i)*day);return {day:d.toISOString().slice(0,10),runs:0};});\nlet ok=0, err=0, durSum=0, durN=0, runs24=0;\nfor (const e of ex) {\n  const t = Date.parse(e.startedAt); if (!t) continue;\n  if (e.status==='success') ok++; else if (e.status==='error' || e.status==='crashed') err++;\n  if (e.stoppedAt) { durSum += Date.parse(e.stoppedAt)-t; durN++; }\n  if (now-t < day) runs24++;\n  const k = new Date(t).toISOString().slice(0,10); const d = days.find(x=>x.day===k); if (d) d.runs++;\n}\nconst total = ok+err;\nreturn [{json:{\n  workflows_total: wfs.length,\n  workflows_active: wfs.filter(w=>w.active).length,\n  runs_7d: ex.length, runs_24h: runs24,\n  success_rate: total ? Math.round(ok/total*1000)/10 : null,\n  errors_caught: err,\n  avg_duration_ms: durN ? Math.round(durSum/durN) : null,\n  last_run_at: ex[0] ? ex[0].startedAt : null,\n  per_day: days,\n  generated_at: new Date().toISOString()\n}}];\n"
      }
    },
    {
      "id": "r",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "https://georgeai.dev"
              },
              {
                "name": "Cache-Control",
                "value": "public, max-age=300"
              },
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      }
    }
