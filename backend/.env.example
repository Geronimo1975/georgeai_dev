# georgeai.dev backend — copy to .env and fill in real values (.env is gitignored)

# generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,georgeai.dev,www.georgeai.dev

# PostgreSQL connection — the DB lives in the VPS 'gethub-postgres' container
# (shared gethub stack), reachable only from inside the gethub docker network.
#
# Production (Django container on gethub-network) connects directly:
#   DATABASE_URL=postgres://georgeai:PASSWORD@gethub-postgres:5432/georgeai
#
# Local dev: open an SSH tunnel to the container, then point at it. Use port 5434
# (5433 is already taken by the n8n-db-tunnel in ~/.ssh/config). One-liner:
#   IP=$(ssh macbook-air "docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' gethub-postgres")
#   ssh -N -L 5434:$IP:5432 macbook-air &
#   DATABASE_URL=postgres://georgeai:PASSWORD@127.0.0.1:5434/georgeai
DATABASE_URL=postgres://georgeai:PASSWORD@127.0.0.1:5434/georgeai
